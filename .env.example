# LEARNING OS — Supabase configuration
#
# Copy this file to ".env" and fill in your values (Supabase → Project Settings → API).
# Vite exposes only vars prefixed with VITE_ to the browser.
# The anon key is safe to expose — it is designed for client apps and protected
# by row-level security.
#
# Without these the app still works fully offline (localStorage). Adding them
# enables cloud file storage for PDFs / images in the `vault` Storage bucket.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
